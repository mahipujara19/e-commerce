PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
CLIENT_URL=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Used by `npm run seed` to create the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_Aa1!

# Email (verification + password reset). Leave SMTP_HOST empty in development:
# the links are then printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="goodthings <no-reply@example.com>"
