# Shared by backend/ and frontend/. Only VITE_* values are exposed to the browser.
# See DEPLOYMENT.md for what production needs. In production (NODE_ENV=production) the API refuses to start
# with weak JWT secrets, a non-https CLIENT_URL, or no payment mode chosen.

NODE_ENV=development

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# Frontend origin: allowed by CORS and used in email links. No trailing slash.
CLIENT_URL=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
# Optional. Signs CSRF tokens; derived from JWT_ACCESS_SECRET when empty.
CSRF_SECRET=

# Cookies. Defaults suit `npm run dev` (same origin through the Vite proxy): SameSite=Lax, Secure only in production.
# If the API and frontend are on different sites in production, use COOKIE_SAMESITE=none (Secure is then forced on)
# and set VITE_API_URL below.
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# Used by `npm run seed`: the admin account is required, the staff account is optional.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_Aa1!
STAFF_EMAIL=
STAFF_PASSWORD=

# Email (verification, password reset, stock alerts). Leave SMTP_HOST empty in development:
# emails are then printed to the server console. In production an empty SMTP_HOST makes sending fail with a clear error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="goodthings <no-reply@example.com>"
# Comma-separated recipients for stock-change emails. Empty: every admin account is emailed.
STOCK_ALERT_EMAILS=

# Support: contact-form messages and new-order alerts go here (also shown to customers via VITE_SUPPORT_EMAIL).
SUPPORT_EMAIL=

# Payment methods, in order (the first is preselected). Any of: cod, razorpay, stripe.
# Leave empty to offer cash on delivery plus every method whose keys are filled in below.
# The storefront offers only cod and stripe. Razorpay stays supported on the server (webhooks, refunds and
# cancelling older orders), but customers are never shown it, so use PAYMENT_METHODS=cod or cod,stripe.
PAYMENT_METHODS=

# Razorpay Dashboard → Account & Settings → API Keys (rzp_test_… in test mode, rzp_live_… when live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Account & Settings → Webhooks: URL https://<your-site>/api/payments/razorpay/webhook,
# events payment.captured, payment.authorized, order.paid. Paste the secret you typed there.
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint for https://<your-api>/api/payments/webhook (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=

# Currency the store shows and charges (ISO code). Use INR with Razorpay. Prices in the catalogue are in this currency.
VITE_CURRENCY=USD
# Store rules in that currency, shared by the bag and the server: free shipping from this subtotal, flat shipping
# below it, and the flat tax rate (0.18 = 18%). Example for India: 999 / 79 / 0.18.
VITE_FREE_SHIPPING_MINIMUM=75
VITE_FLAT_SHIPPING=5.99
VITE_TAX_RATE=0.08

# Shipping rates. "flat" = $5.99 under $75, free above. "shippo" = live carrier rates (cheapest used) from Shippo.
# Any Shippo error or timeout falls back to the flat rate automatically, so checkout never breaks.
SHIPPING_PROVIDER=flat
SHIPPO_API_KEY=
# Ship-from address (required for shippo). Country is a 2-letter code: US, IN, GB...
SHIP_FROM_NAME=
SHIP_FROM_STREET=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
# Box size in inches (LxWxH), weight per item in pounds, and a handling fee added to the carrier rate.
SHIP_PARCEL_IN=12x9x4
SHIP_ITEM_WEIGHT_LB=1
SHIP_HANDLING_FEE=0

# Tax. "flat" = 8% of goods. "stripe" = Stripe Tax by destination (needs STRIPE_SECRET_KEY and Stripe Tax enabled).
# Any Stripe Tax error or timeout falls back to the flat rate automatically.
TAX_PROVIDER=flat

# Signup reCAPTCHA (v2 "I'm not a robot" checkbox). Create one registration at https://www.google.com/recaptcha/admin
# with your domains (for example localhost and your-project.vercel.app). It gives two keys that must be used together:
#   Site key   → VITE_RECAPTCHA_SITE_KEY (below, or .env.local). Public; built into the frontend.
#   Secret key → RECAPTCHA_SECRET_KEY (here). Server only; never put it in a VITE_ variable.
# Production: both are required. Without the secret, sign-up is refused (the check is never skipped), and the
# frontend shows sign-up as unavailable if it was built without the site key.
# Development: leave both empty to run without reCAPTCHA; the server prints a warning and skips the check.
RECAPTCHA_SECRET_KEY=

# true: the API also serves the built frontend (frontend/dist) on the same origin. Simplest single-service deploy.
SERVE_CLIENT=false
# Shown in /api/health, e.g. a git commit hash set by your deploy pipeline.
RELEASE=

# Frontend (can also go in .env.local)
# reCAPTCHA site key, paired with RECAPTCHA_SECRET_KEY above.
VITE_RECAPTCHA_SITE_KEY=
# Only when the API is on another origin, e.g. https://api.example.com. Empty uses /api on the same origin.
VITE_API_URL=
# Public URL of the storefront, for canonical and social-sharing links. Empty uses the current origin.
VITE_SITE_URL=
# Google Analytics 4 measurement id (G-XXXXXXX). Empty disables analytics and the cookie banner.
VITE_GA_MEASUREMENT_ID=
# Business details for the contact, legal and policy pages. Empty values are simply not shown.
VITE_STORE_LEGAL_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_STORE_ADDRESS=
VITE_SUPPORT_HOURS=
VITE_POLICIES_UPDATED=
# Payment badges in the footer; match what your Stripe account actually offers.
VITE_PAYMENT_BADGES=Visa,Mastercard,Amex,Apple Pay,Google Pay

# Vercel only: any long random text. Lets Vercel's daily job release stock held by unpaid online orders.
CRON_SECRET=
